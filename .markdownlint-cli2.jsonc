// The ONE markdownlint config for this repo (markdownlint-cli2, run via pre-commit).
{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false
  },
  // Superpowers process artifacts (design specs / implementation plans) are
  // development records, not shipped project documentation.
  "ignores": ["docs/superpowers/**"]
}
